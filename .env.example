# Never commit .env.

# --- Active provider: Groq (free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b

# --- Alternative: DeepSeek (paid credits). To use it, comment the Groq block and uncomment this one. ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-flash

# --- Alternative: Gemini (free tier, slow) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-3.8-flash

# Optional: reasoning effort sent to the model (empty = not sent).
# LLM_REASONING_EFFORT=low

# --- Keys by provider, used only by test scripts (the app reads only LLM_*) ---
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
