# Copy this file to .env and fill in your key. Never commit .env.

# Default provider: Groq (free tier), OpenAI-compatible endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b

# Alternative provider: Google Gemini (free tier). Comment the block above and uncomment this one.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-3.8-flash
